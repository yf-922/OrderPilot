MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=product
MYSQL_ROOT_PASSWORD=root
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
APP_ADDR=127.0.0.1:8080
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MAX_REQUEST_BODY_BYTES=1048576
# 留空时启用可离线运行的确定性 Agent 演示模式。
AI_PROVIDER=grok
XAI_API_KEY=
# 如果你的 Grok CLI 使用此变量名，也可只配置 GROK_API_KEY。
GROK_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.6
# 本地请求 Token 预算；固定编码不保证等于 Provider 计费口径。
AGENT_CONTEXT_TOKEN_BUDGET=12000
AGENT_CONTEXT_STRATEGY=ours_full
AGENT_TOKEN_ENCODING=cl100k_base
AGENT_TOKENIZER_URL=http://127.0.0.1:8091
# 上游超时与重试上限；默认不重试，避免重复费用。
AI_REQUEST_TIMEOUT_MS=35000
AI_PROVIDER_MAX_RETRIES=0
AGENT_JEV_ENABLED=true
AGENT_JEV_SHADOW=false
# 官方 Jev 使用独立凭据与原生 /systemone 接口，不复用 AI_API_KEY。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# 可选，仅影响 TypeSafe；Clash Verge 混合端口示例：http://127.0.0.1:7897
TYPESAFE_PROXY_URL=
JEV_MODEL=jev-1.13.0
JEV_EXTERNAL_ENABLED=false
JEV_TIMEOUT_MS=2000
JEV_MIN_CONFIDENCE=0.7
# 常驻 Tokenizer 需单独启动；Compose 尚未编排，容器不能直接使用宿主机回环地址。
# 可选 RAG 适配器；留空使用本地检索。
# EMBEDDING_BASE_URL=https://your-compatible-gateway/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# PGVECTOR_DSN=postgres://rag:rag@127.0.0.1:5432/rag?sslmode=disable
PGVECTOR_USER=rag
PGVECTOR_PASSWORD=rag
PGVECTOR_DATABASE=rag
